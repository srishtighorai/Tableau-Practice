      <aliases enabled='yes' />
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1368249927221915648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='fixed category sales' datatype='real' name='[Calculation_1953333146857472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Category]: SUM([Sales]) }' />
      </column>
      <column caption='% of category sales' datatype='real' name='[Calculation_1953333159182337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])/SUM([Calculation_1953333146857472])' />
      </column>
      <column aggregation='Attribute' caption='exclude sub category' datatype='real' name='[Calculation_1953333163610114]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ EXCLUDE [Sub-Category]: SUM([Sales]) }' />
      </column>
      <column caption='include sub category' datatype='real' name='[Calculation_1953333167534083]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ INCLUDE [Sub-Category]: SUM([Sales]) }' />
      </column>
      <column caption='sales_rank' datatype='integer' name='[Calculation_28361127898083328]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='rank(sum([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='sales_consumer' datatype='real' name='[Calculation_28361127899406337]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Segment]= &quot;consumer&quot;&#13;&#10;then [Sales]&#13;&#10;END' />
      </column>
      <column aggregation='Sum' caption='sales_coporate' datatype='real' name='[Calculation_28361127899668482]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='if [Segment]=&quot;corporate&quot;&#13;&#10;then [Sales]&#13;&#10;END' />
      </column>
      <column caption='profit by quantity' datatype='real' name='[Calculation_35999710424809473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/ sum([Quantity])' />
      </column>
      <column caption='profit margin' datatype='real' name='[Calculation_35999710425485314]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Profit])/ sum([Sales])' />
      </column>
      <column caption='profit status' datatype='string' name='[Calculation_38740518224912385]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF  SUM([Profit])&gt;0&#13;&#10;THEN &quot;profit making&quot;&#13;&#10;else &quot;loss making&quot;&#13;&#10;end' />
      </column>
